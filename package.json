{
  "name": "botville",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev:server": "npm run dev --workspace=packages/server",
    "dev:client": "npm run dev --workspace=packages/client",
    "deploy:client": "node scripts/sync-assets.mjs && vercel pull --yes --environment=production && vercel build --prod && vercel deploy --prebuilt --prod",
    "deploy:server": "node scripts/deploy-server.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "puppeteer-core": "^25.3.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.17.0"
}
