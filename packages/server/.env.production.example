# ─────────────────────────────────────────────────────────────────────────────
# BotVille — PRODUCTION env for the SERVER (Railway). TEMPLATE, no real values.
# Do NOT commit a file with actual secrets. All values are entered in Railway →
# service → Variables tab. Detailed runbook: docs/DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────────────

# --- Basics ---
NODE_ENV=production
# PORT is set by Railway itself — do NOT add this variable manually.

# --- Secrets (required, ≥32 characters, DIFFERENT from each other) ---
# Generate EACH ONE with a separate command:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<paste_generated_secret_1>
ENCRYPTION_SECRET=<paste_generated_secret_2_SEPARATE>

# --- CORS / cookie (cross-site: Vercel client + Railway server = different sites) ---
# The client URL on Vercel (available after deploy step 2). Comma-separated list.
CLIENT_ORIGIN=https://<your-app>.vercel.app
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# --- Database (SQLite on a persistent volume) ---
# The volume is mounted at /data (see runbook). The file survives redeploys.
DB_PATH=/data/botville.db

# --- Demo mode (the agent replies without a user API key) ---
DEMO_ENABLED=true
DEMO_PROVIDER=deepseek
DEMO_MODEL=deepseek-chat
DEMO_API_KEY=<funded_DeepSeek_key>
DEMO_MESSAGE_LIMIT=10
DEMO_IP_DAILY_LIMIT=30

# --- Owner stats (TZ-18) ---
# Enables read-only GET /api/admin/stats (aggregates only, no personal data).
# While the variable is unset, the endpoint is disabled and responds with 404.
# Generate a SEPARATE secret; do not reuse SESSION/ENCRYPTION:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATS_TOKEN=<paste_generated_secret_3_SEPARATE>

# --- Optional (defaults exist in code) ---
# RATE_LIMIT_CHAT_PER_MIN=20
# RATE_LIMIT_MEETING_PER_MIN=5
# RATE_LIMIT_GLOBAL_PER_MIN=100
# RATE_LIMIT_STATS_PER_MIN=10
# SESSION_MAX_AGE_DAYS=180
