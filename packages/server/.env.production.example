# ─────────────────────────────────────────────────────────────────────────────
# BotVille — ПРОД env для СЕРВЕРА (Railway). ШАБЛОН, без реальных значений.
# НЕ коммить файл с настоящими секретами. Все значения вводятся в Railway →
# сервис → вкладка Variables. Подробный runbook: docs/DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────────────

# --- Базовое ---
NODE_ENV=production
# PORT задаёт сам Railway — НЕ добавляй эту переменную вручную.

# --- Секреты (обязательны, ≥32 символа, РАЗНЫЕ) ---
# Сгенерируй КАЖДЫЙ отдельной командой:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<вставь_сгенерированный_секрет_1>
ENCRYPTION_SECRET=<вставь_сгенерированный_секрет_2_ОТДЕЛЬНЫЙ>

# --- CORS / cookie (кросс-сайт: клиент Vercel + сервер Railway = разные сайты) ---
# URL клиента с Vercel (появится после шага 2 деплоя). Список через запятую.
CLIENT_ORIGIN=https://<твоё-приложение>.vercel.app
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# --- База данных (SQLite на persistent-volume) ---
# Volume монтируется в /data (см. runbook). Файл переживёт редеплой.
DB_PATH=/data/botville.db

# --- Demo-режим (агент отвечает без ключа пользователя) ---
DEMO_ENABLED=true
DEMO_PROVIDER=deepseek
DEMO_MODEL=deepseek-chat
DEMO_API_KEY=<пополненный_ключ_DeepSeek>
DEMO_MESSAGE_LIMIT=10
DEMO_IP_DAILY_LIMIT=30

# --- Статистика владельца (ТЗ-18) ---
# Открывает read-only GET /api/admin/stats (только агрегаты, без персональных
# данных). Пока переменная не задана — эндпоинт выключен и отвечает 404.
# Сгенерируй ОТДЕЛЬНЫЙ секрет, не переиспользуй SESSION/ENCRYPTION:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATS_TOKEN=<вставь_сгенерированный_секрет_3_ОТДЕЛЬНЫЙ>

# --- Необязательное (есть дефолты в коде) ---
# RATE_LIMIT_CHAT_PER_MIN=20
# RATE_LIMIT_MEETING_PER_MIN=5
# RATE_LIMIT_GLOBAL_PER_MIN=100
# RATE_LIMIT_STATS_PER_MIN=10
# SESSION_MAX_AGE_DAYS=180
