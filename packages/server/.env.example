PORT=3001
# CORS allowlist. Список origin'ов через запятую (прод + preview), не '*'.
# Пример прод: CLIENT_ORIGIN=https://botville.app,https://botville.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# Секреты обязательны. В production сервер НЕ стартует, если секрет отсутствует,
# короче 32 символов или остался заглушкой 'change-this...'. Сгенерируй свои:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=change-this-to-a-random-secret-min-32-chars
DB_PATH=./botville.db
SESSION_SECRET=change-this-to-another-random-secret-min-32-chars

# Cookie-флаги (финализируются на деплое, ТЗ-05). При кросс-сайт деплое
# (клиент Vercel + сервер Railway — разные домены) нужен COOKIE_SAMESITE=none,
# тогда secure форсится автоматически. Локально по умолчанию lax.
# COOKIE_SAMESITE=lax        # lax | strict | none
# COOKIE_SECURE=             # true|false; по умолчанию включён в production

# Demo mode (TZ-02): первый агент отвечает без ключа пользователя
DEMO_ENABLED=true
DEMO_PROVIDER=deepseek
DEMO_MODEL=deepseek-chat
DEMO_API_KEY=your-deepseek-key
DEMO_MESSAGE_LIMIT=10
DEMO_IP_DAILY_LIMIT=30
# DEMO_BASE_URL=            # optional: override provider base URL
# RATE_LIMIT_CHAT_PER_MIN=20
# RATE_LIMIT_MEETING_PER_MIN=5
# RATE_LIMIT_GLOBAL_PER_MIN=100
# SESSION_MAX_AGE_DAYS=180

# Статистика владельца (ТЗ-18): GET /api/admin/stats.
# Без заданного секрета (или короче 32 символов) эндпоинт ВЫКЛЮЧЕН — 404.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# STATS_TOKEN=
# RATE_LIMIT_STATS_PER_MIN=10
