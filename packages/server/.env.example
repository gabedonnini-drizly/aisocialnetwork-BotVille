PORT=3001
# CORS allowlist. Comma-separated list of origins (prod + preview), not '*'.
# Prod example: CLIENT_ORIGIN=https://botville.app,https://botville.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# Secrets are required. In production the server will NOT start if a secret is
# missing, shorter than 32 characters, or still the 'change-this...' placeholder.
# Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=change-this-to-a-random-secret-min-32-chars
DB_PATH=./botville.db
SESSION_SECRET=change-this-to-another-random-secret-min-32-chars

# Cookie flags (finalized at deploy time, TZ-05). For a cross-site deploy
# (Vercel client + Railway server — different domains) you need COOKIE_SAMESITE=none,
# in which case secure is forced automatically. Locally the default is lax.
# COOKIE_SAMESITE=lax        # lax | strict | none
# COOKIE_SECURE=             # true|false; enabled by default in production

# Demo mode (TZ-02): the first agent replies without a user API key
DEMO_ENABLED=true
DEMO_PROVIDER=deepseek
DEMO_MODEL=deepseek-chat
DEMO_API_KEY=your-deepseek-key
DEMO_MESSAGE_LIMIT=10
DEMO_IP_DAILY_LIMIT=30
# DEMO_BASE_URL=            # optional: override provider base URL
# RATE_LIMIT_CHAT_PER_MIN=20
# RATE_LIMIT_MEETING_PER_MIN=5
# RATE_LIMIT_GLOBAL_PER_MIN=100
# SESSION_MAX_AGE_DAYS=180

# Owner stats (TZ-18): GET /api/admin/stats.
# Without a configured secret (or one shorter than 32 characters) the endpoint
# is DISABLED — 404.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# STATS_TOKEN=
# RATE_LIMIT_STATS_PER_MIN=10
