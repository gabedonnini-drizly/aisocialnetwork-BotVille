# Dependencies
node_modules/

# Build output
dist/
.turbo/
*.tsbuildinfo

# Secrets — only *.example templates are committed
.env
.env.*
!.env.example
!.env.production.example

# Local database
*.db
*.db-shm
*.db-wal

# Paid LimeZu art — licence permits use, forbids redistribution
assets-src
packages/client/public/assets/tilesets/limezu/
packages/client/public/assets/sprites/limezu/
packages/client/public/assets/ui/limezu/

# Deploy remote config (written by scripts/deploy-server.mjs)
.deploy-server.json

# Editor / OS
.DS_Store
.vscode/
.idea/

# Internal tooling
.claude/

# Full per-cell pack inventory — regenerable browsing aid (npm run pack:index).
# The small sheets manifest beside it IS committed: its diff is how a pack
# update announces itself.
sources/*.index.json

# Generated synthetic test pack (npm run fixture) — pixels are derived, not authored
test/fixtures/pack-src/

# Contact sheets — regenerable review artifacts (npm run contact). They render
# licensed pixels when built against a real pack, so they never enter git.
contact/
